{
  "name": "fire-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-data.mjs",
    "package:azure": "node scripts/package-azure.mjs",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.7",
    "next": "16.3.5",
    "pg": "^8.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^26",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^7"
  }
}
