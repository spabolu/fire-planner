# Optional live, read-only YNAB refresh. Never use NEXT_PUBLIC_ for this token.
YNAB_ACCESS_TOKEN=

# Optional PostgreSQL; omit to use local JSON files.
# Use certificate-verified TLS for Azure. Never commit a real connection string.
DATABASE_URL=

# Azure only: App Service Easy Auth must also be enabled and restricted to this user.
APP_AUTH_MODE=local
APP_ALLOWED_PRINCIPAL_IDS=
APP_ORIGIN=
